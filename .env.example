# AVASYA environment configuration (copy to .env; never commit .env)

# --- Backend -----------------------------------------------------------
# PostgreSQL/PostGIS connection string
DATABASE_URL=postgresql+psycopg://avasya:avasya@localhost:5432/avasya
# Comma-separated CORS origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_ENV=development
DB_ECHO=false
# Where ingestion looks for datasets (real archives go here on the host)
DATA_DIR=./data/raw

# --- Frontend ----------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:58000
# false = consume the live API; true = labelled offline demo data
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_DEMO_OFFICER_EMAIL=demo.officer@avasya.local

# --- RAG subsystem (backend/rag; contract: docs/RAG_INTEGRATION.md) ----
# null = zero-vector stub (demo/tests); huggingface = real E5 embeddings
EMBEDDING_PROVIDER=null
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_PATH=models/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32

# --- Supabase (backend auth + optional storage) ------------------------
# Leave unset to keep the documented X-Officer-Email demo auth.
SUPABASE_URL=
# HS256 JWT secret (Dashboard -> Settings -> API -> JWT Secret) - backend only
SUPABASE_JWT_SECRET=
# Service-role key only for backend Storage helpers - never expose client-side
SUPABASE_SERVICE_ROLE_KEY=
# Auto-create users rows for valid JWTs (role-less until admin grants officer)
SUPABASE_AUTO_PROVISION=true

# --- Frontend Supabase (build-time; anon/publishable key only) ---------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LLM runtime (ai/llm; contract: docs/LLM_INTEGRATION.md) -----------
# Empty = honest 503 from /llm endpoints (extractive fallback answers).
# Option A - Ollama (teammate E's runtime; easiest trigger):
#   docker compose --profile ollama up -d
#   docker compose exec ollama ollama pull llama3.2:3b
# then uncomment:
# AVASYA_LLM_RUNTIME=ollama
# AVASYA_LLM_OLLAMA_URL=http://localhost:11434   # or http://ollama:11434 in compose
# AVASYA_LLM_OLLAMA_MODEL=llama3.2:3b
# Option B - llama.cpp CLI/server (Qwen3-8B-Q4_K_M.gguf):
# AVASYA_LLM_RUNTIME=server
# AVASYA_LLM_SERVER_URL=http://localhost:8081    # or http://llm:8000 in compose
# AVASYA_LLM_CLI_PATH=
# AVASYA_LLM_MODEL_PATH=
# Tuning (applies to every runtime):
# AVASYA_LLM_TEMPERATURE=0.1
# AVASYA_LLM_MAX_TOKENS=700
# AVASYA_LLM_TIMEOUT=120
