# Optional AVASYA LLM runtime — llama.cpp server (OpenAI-compatible API).
#
# Built and run only via the compose `llm` profile:
#   docker compose --profile llm up -d --build
#
# The model GGUF is NOT baked into the image (multi-GB); it is mounted from
# ./models at runtime:
#   models/Qwen3-8B-Q4_K_M.gguf   (download from Hugging Face)
#
# Backend wiring: set AVASYA_LLM_RUNTIME=server and
# AVASYA_LLM_SERVER_URL=http://llm:8000 to make /llm/explain and
# /rag/answer use live inference.
FROM ghcr.io/ggml-org/llama.cpp:server

ENV LLAMA_ARG_MODEL=/models/Qwen3-8B-Q4_K_M.gguf \
    LLAMA_ARG_CTX_SIZE=4096 \
    LLAMA_ARG_N_GPU_LAYERS=0 \
    LLAMA_ARG_HOST=0.0.0.0 \
    LLAMA_ARG_PORT=8000

USER 1000:1000
EXPOSE 8000
ENTRYPOINT ["/app/llama-server"]
