# Build-context hygiene: the backend build context is the repo root, so
# keep huge/secret/irrelevant things out of the image layers.

# --- VCS / editor ---
.git
.github
.vscode
.freebuff

# --- Frontend (own build context; not needed in backend image) ---
frontend/node_modules
frontend/.next
frontend/build

# --- Python artifacts ---
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/*.egg-info

# --- Environments & secrets (NEVER bake into images) ---
.env
.env.*
!.env.example

# --- Data that is mounted, not copied ---
data/raw/*
!data/raw/
!data/raw/habitations.geojson
!data/raw/hazards.geojson
!data/raw/relief_centers.geojson
!data/raw/historical_events.csv
data/processed
models
*.gguf

# --- Docs & logs (not needed at runtime) ---
*.log
build_check.log
docs/
*.md
!alembic.ini
